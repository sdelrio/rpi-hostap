<div class="card-grid">
	<slot />
</div>

<style>
	@layer starlight.core {
		.card-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
			margin: 2rem 0;
		}

		@media (min-width: 50rem) {
			.card-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (min-width: 72rem) {
			.card-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	}
</style>
